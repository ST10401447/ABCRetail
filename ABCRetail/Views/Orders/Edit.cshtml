@model ABCRetail.Models.OrderEntity

@{
    ViewData["Title"] = "Edit Order";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-7 col-xl-6">

            <div class="mb-4">
                <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                    <i class="bi bi-arrow-left me-2"></i>Back to Orders
                </a>
            </div>

            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="bg-warning bg-gradient text-dark p-4 p-md-5 text-center">
                    <div class="bg-white bg-opacity-50 rounded-circle d-inline-flex align-items-center justify-content-center mb-3"
                         style="width: 90px; height: 90px;">
                        <i class="bi bi-pencil-square" style="font-size: 2.6rem;"></i>
                    </div>
                    <h2 class="fw-bold mb-1">Edit Order</h2>
                    <p class="mb-0 opacity-75">Update the order details below</p>
                </div>

                <div class="card-body p-4 p-md-5">
                    <form asp-action="Edit" method="post">
                        @Html.AntiForgeryToken()

                        <input type="hidden" asp-for="PartitionKey" />
                        <input type="hidden" asp-for="RowKey" />
                        <input type="hidden" asp-for="ETag" />

                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="ProductName" class="form-label fw-semibold">Product Name</label>
                            <input asp-for="ProductName" class="form-control form-control-lg" required />
                            <span asp-validation-for="ProductName" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Quantity" class="form-label fw-semibold">Quantity</label>
                            <input asp-for="Quantity" class="form-control form-control-lg" type="number" min="1" required />
                            <span asp-validation-for="Quantity" class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Price" class="form-label fw-semibold">Price (R)</label>
                            <input asp-for="Price" class="form-control form-control-lg" type="number" min="0" required />
                            <span asp-validation-for="Price" class="text-danger"></span>
                        </div>

                        <div class="d-flex flex-wrap gap-3">
                            <button type="submit" class="btn btn-warning rounded-pill px-4 py-2">
                                <i class="bi bi-check-lg me-2"></i>Save Changes
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 py-2">
                                Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}