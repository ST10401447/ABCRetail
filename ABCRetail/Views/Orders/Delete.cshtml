@model ABCRetail.Models.OrderEntity

@{
    ViewData["Title"] = "Delete Order";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-7 col-xl-6">

            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="bg-danger bg-gradient text-white p-4 p-md-5 text-center">
                    <div class="bg-white bg-opacity-25 rounded-circle d-inline-flex align-items-center justify-content-center mb-3"
                         style="width: 90px; height: 90px;">
                        <i class="bi bi-trash3-fill text-white" style="font-size: 2.8rem;"></i>
                    </div>
                    <h2 class="fw-bold mb-1">Delete Order</h2>
                    <p class="mb-0 opacity-75">This action cannot be undone</p>
                </div>

                <div class="card-body p-4 p-md-5 text-center">
                    <div class="bg-light rounded-3 p-4 mb-4 text-start">
                        <div class="mb-3">
                            <small class="text-muted d-block">Product Name</small>
                            <strong class="fs-5">@Model.ProductName</strong>
                        </div>
                        <div class="mb-3">
                            <small class="text-muted d-block">Quantity</small>
                            <strong class="fs-5">@Model.Quantity</strong>
                        </div>
                        <div>
                            <small class="text-muted d-block">Price</small>
                            <strong class="fs-5">R @Model.Price</strong>
                        </div>
                    </div>

                    <p class="text-muted mb-4">
                        Are you sure you want to permanently delete this order?
                    </p>

                    <form asp-action="Delete" method="post" class="d-flex justify-content-center gap-3">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="partitionKey" value="@Model.PartitionKey" />
                        <input type="hidden" name="rowKey" value="@Model.RowKey" />

                        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 py-2">
                            Cancel
                        </a>
                        <button type="submit" class="btn btn-danger rounded-pill px-4 py-2">
                            <i class="bi bi-trash3 me-1"></i> Yes, Delete
                        </button>
                    </form>
                </div>
            </div>

        </div>
    </div>
</div>