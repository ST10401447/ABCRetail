@model ABCRetail.Models.QueueMessageViewModel
@{
    ViewData["Title"] = "Message Details";
}

<div class="container-fluid px-4 py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Message Details</h2>
            <p class="text-muted mb-0">View complete message information</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Back to Messages
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-7 col-xl-6">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                <!-- Card Header -->
                <div class="card-header bg-primary text-white border-0 py-3 px-4">
                    <div class="d-flex align-items-center">
                        <div class="bg-white bg-opacity-25 rounded-circle d-flex align-items-center justify-content-center me-3"
                             style="width: 48px; height: 48px;">
                            <i class="bi bi-envelope-fill fs-4"></i>
                        </div>
                        <div>
                            <h5 class="mb-0 fw-bold">Order Message</h5>
                            <small class="opacity-75">Queue message details</small>
                        </div>
                    </div>
                </div>

                <!-- Card Body -->
                <div class="card-body p-4 p-lg-5">
                    <div class="mb-4">
                        <label class="form-label text-muted small fw-semibold text-uppercase mb-1">Message ID</label>
                        <div class="p-3 bg-light rounded-3">
                            <code class="text-dark">@Model.MessageId</code>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label text-muted small fw-semibold text-uppercase mb-1">Message Text</label>
                        <div class="p-3 bg-light rounded-3">
                            <span class="fw-semibold fs-5">@Model.MessageText</span>
                        </div>
                    </div>

                    <div class="mb-2">
                        <label class="form-label text-muted small fw-semibold text-uppercase mb-1">Inserted On</label>
                        <div class="p-3 bg-light rounded-3 d-flex align-items-center">
                            <i class="bi bi-calendar3 me-2 text-primary"></i>
                            <span>@(Model.InsertedOn?.ToString("dddd, dd MMMM yyyy HH:mm:ss") ?? "N/A")</span>
                        </div>
                    </div>
                </div>

                <!-- Card Footer -->
                <div class="card-footer bg-white border-top-0 px-4 pb-4">
                    <div class="d-flex gap-2">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-1"></i> Back
                        </a>
                        <a asp-action="Delete"
                           asp-route-messageId="@Model.MessageId"
                           class="btn btn-outline-danger">
                            <i class="bi bi-trash me-1"></i> Delete
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>