@model List<ABCRetail.Models.LogFile>

@{
    ViewData["Title"] = "Log Files";
    int counter = 1;
}

<div class="container-fluid px-4 py-4">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Log Files</h2>
            <p class="text-muted mb-0">Upload, download and manage log files</p>
        </div>
    </div>

    <!-- Upload Card -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-4">
            <h5 class="fw-bold mb-3">
                <i class="bi bi-cloud-upload me-2 text-primary"></i>Upload New File
            </h5>
            <form asp-action="Upload" method="post" enctype="multipart/form-data" class="row g-3 align-items-end">
                <div class="col-md-9">
                    <label class="form-label fw-semibold">Select File</label>
                    <input type="file" name="file" class="form-control form-control-lg" required />
                </div>
                <div class="col-md-3">
                    <button type="submit" class="btn btn-primary btn-lg w-100">
                        <i class="bi bi-upload me-1"></i> Upload File
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Files Table -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-body p-0">
            @if (Model == null || Model.Count == 0)
            {
                <div class="text-center py-5">
                    <i class="bi bi-folder2-open display-4 text-muted"></i>
                    <h5 class="text-muted mt-3">No log files found</h5>
                    <p class="text-muted mb-0">Upload a file using the form above.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr class="table-header-blue">
                                <th class="ps-4" style="width: 70px;">ID</th>
                                <th>File Name</th>
                                <th style="width: 150px;">Size (bytes)</th>
                                <th class="text-end pe-4" style="width: 220px;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var log in Model)
                            {
                                <tr>
                                    <td class="ps-4 fw-bold">@counter</td>
                                    <td>
                                        <i class="bi bi-file-earmark-text me-2 text-muted"></i>
                                        @log.FileName
                                    </td>
                                    <td class="text-muted">@log.FileSize</td>
                                    <td class="text-end pe-4">
                                        <div class="d-flex justify-content-end gap-2">
                                            <a asp-action="Download"
                                               asp-route-fileName="@log.FileName"
                                               class="btn btn-outline-success btn-sm">
                                                <i class="bi bi-download"></i> Download
                                            </a>
                                            <a asp-action="Delete"
                                               asp-route-fileName="@log.FileName"
                                               class="btn btn-outline-danger btn-sm">
                                                <i class="bi bi-trash"></i> Delete
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                                counter++;
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>