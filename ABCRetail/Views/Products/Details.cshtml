@model ABCRetail.Models.ProductEntity

@{
    ViewData["Title"] = "Product Details";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-10">

            <!-- Header -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h2 class="fw-bold mb-1">Product Details</h2>
                    <p class="text-muted mb-0">View full information about this product</p>
                </div>
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i> Back to List
                </a>
            </div>

            <div class="card shadow-sm border-0 overflow-hidden">
                <div class="row g-0">

                    <!-- Product Image -->
                    <div class="col-md-5 bg-light d-flex align-items-center justify-content-center p-4">
                        @if (!string.IsNullOrEmpty(Model.ProductImageUrl))
                        {
                            <img src="@Model.ProductImageUrl"
                                 alt="@Model.ProductName"
                                 class="img-fluid rounded shadow-sm"
                                 style="max-height: 380px; object-fit: contain;" />
                        }
                        else
                        {
                            <div class="text-center text-muted py-5">
                                <i class="bi bi-image display-1"></i>
                                <p class="mt-2 mb-0">No image available</p>
                            </div>
                        }
                    </div>

                    <!-- Product Information -->
                    <div class="col-md-7">
                        <div class="card-body p-4 p-lg-5">

                            <h3 class="fw-bold mb-2">@Model.ProductName</h3>

                            <div class="mb-4">
                                <span class="badge @(Model.StockQuantity > 0 ? "bg-success" : "bg-danger") fs-6">
                                    @(Model.StockQuantity > 0 ? $"{Model.StockQuantity} in stock" : "Out of stock")
                                </span>
                            </div>

                            <div class="mb-4">
                                <h4 class="text-primary fw-bold mb-0">
                                    R @(Model.Price.HasValue ? Model.Price.Value.ToString("N0") : "N/A")
                                </h4>
                            </div>

                            <hr class="my-4" />

                            <div class="mb-4">
                                <h6 class="text-muted text-uppercase small fw-semibold mb-2">Description</h6>
                                <p class="mb-0">
                                    @(string.IsNullOrEmpty(Model.Description) ? "No description provided." : Model.Description)
                                </p>
                            </div>

                            <div class="row g-3 mb-4">
                                <div class="col-sm-6">
                                    <h6 class="text-muted text-uppercase small fw-semibold mb-1">Partition Key</h6>
                                    <p class="mb-0 font-monospace small">@Model.PartitionKey</p>
                                </div>
                                <div class="col-sm-6">
                                    <h6 class="text-muted text-uppercase small fw-semibold mb-1">Row Key</h6>
                                    <p class="mb-0 font-monospace small text-break">@Model.RowKey</p>
                                </div>
                            </div>

                            @if (Model.Timestamp.HasValue)
                            {
                                <div class="mb-4">
                                    <h6 class="text-muted text-uppercase small fw-semibold mb-1">Last Updated</h6>
                                    <p class="mb-0">@Model.Timestamp.Value.LocalDateTime.ToString("dd MMM yyyy, HH:mm")</p>
                                </div>
                            }

                            <!-- Action Buttons -->
                            <div class="d-flex gap-2 pt-2">
                                <a asp-action="Edit"
                                   asp-route-partitionKey="@Model.PartitionKey"
                                   asp-route-rowKey="@Model.RowKey"
                                   class="btn btn-primary">
                                    <i class="bi bi-pencil me-1"></i> Edit
                                </a>

                                <a asp-action="Delete"
                                   asp-route-partitionKey="@Model.PartitionKey"
                                   asp-route-rowKey="@Model.RowKey"
                                   class="btn btn-outline-danger">
                                    <i class="bi bi-trash me-1"></i> Delete
                                </a>
                            </div>

                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>