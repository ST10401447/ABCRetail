@model ABCRetail.Models.CustomerProfile

@{
    ViewData["Title"] = "Customer Details";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-xl-7">

            <!-- Back button -->
            <div class="mb-4">
                <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                    <i class="bi bi-arrow-left me-2"></i>Back to Customers
                </a>
            </div>

            <!-- Main Card -->
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">

                <!-- Header -->
                <div class="bg-primary bg-gradient text-white p-4 p-md-5 text-center">
                    <div class="bg-white bg-opacity-25 rounded-circle d-inline-flex align-items-center justify-content-center mb-3"
                         style="width: 100px; height: 100px;">
                        <i class="bi bi-person-fill text-white" style="font-size: 3.2rem;"></i>
                    </div>
                    <h2 class="fw-bold mb-1">@Model.FullName</h2>
                    <p class="mb-0 opacity-75">@Model.Email</p>
                </div>

                <!-- Body -->
                <div class="card-body p-4 p-md-5">

                   
                    <div class="row g-4">
                        <div class="col-sm-6">
                            <div class="bg-light rounded-3 p-3 h-100">
                                <div class="text-muted small text-uppercase fw-semibold mb-1">
                                    <i class="bi bi-telephone me-1"></i>Phone Number
                                </div>
                                <div class="fs-5 fw-semibold">@Model.PhoneNumber</div>
                            </div>
                        </div>

                        <div class="col-sm-6">
                            <div class="bg-light rounded-3 p-3 h-100">
                                <div class="text-muted small text-uppercase fw-semibold mb-1">
                                    <i class="bi bi-geo-alt me-1"></i>Postal Code
                                </div>
                                <div class="fs-5 fw-semibold">@Model.PostalCode</div>
                            </div>
                        </div>

                        <div class="col-sm-6">
                            <div class="bg-light rounded-3 p-3 h-100">
                                <div class="text-muted small text-uppercase fw-semibold mb-1">
                                    <i class="bi bi-house me-1"></i>Address
                                </div>
                                <div class="fs-5 fw-semibold">@Model.Address</div>
                            </div>
                        </div>

                        <div class="col-sm-6">
                            <div class="bg-light rounded-3 p-3 h-100">
                                <div class="text-muted small text-uppercase fw-semibold mb-1">
                                    <i class="bi bi-building me-1"></i>City
                                </div>
                                <div class="fs-5 fw-semibold">@Model.City</div>
                            </div>
                        </div>
                    </div>

                    <!-- Technical Keys -->
                    <div class="mt-4 pt-3 border-top">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="text-muted small text-uppercase fw-semibold mb-1">Partition Key</div>
                                <code class="small">@Model.PartitionKey</code>
                            </div>
                            <div class="col-md-6">
                                <div class="text-muted small text-uppercase fw-semibold mb-1">Row Key</div>
                                <code class="small text-break">@Model.RowKey</code>
                            </div>
                        </div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="d-flex flex-wrap gap-3 mt-5">
                        <a asp-action="Edit"
                           asp-route-partitionKey="@Model.PartitionKey"
                           asp-route-rowKey="@Model.RowKey"
                           class="btn btn-primary rounded-pill px-4 py-2">
                            <i class="bi bi-pencil me-2"></i>Edit Customer
                        </a>

                        <a asp-action="Delete"
                           asp-route-partitionKey="@Model.PartitionKey"
                           asp-route-rowKey="@Model.RowKey"
                           class="btn btn-outline-danger rounded-pill px-4 py-2">
                            <i class="bi bi-trash me-2"></i>Delete
                        </a>

                        <a asp-action="Index"
                           class="btn btn-outline-secondary rounded-pill px-4 py-2 ms-auto">
                            Back to List
                        </a>
                    </div>

                </div>
            </div>

        </div>
    </div>
</div>