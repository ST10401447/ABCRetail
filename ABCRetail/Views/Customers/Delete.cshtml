@model ABCRetail.Models.CustomerProfile

@{
    ViewData["Title"] = "Delete Customer";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">

            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <!-- Header -->
                <div class="bg-danger bg-gradient text-white p-4 text-center">
                    <h3 class="mb-1 fw-bold">
                        <i class="bi bi-person-x-fill me-2"></i>Delete Customer
                    </h3>
                    <p class="mb-0 opacity-75">This action cannot be undone</p>
                </div>

                <!-- Body -->
                <div class="card-body p-4">
                    <div class="text-center mb-4">
                        <div class="bg-light rounded-circle d-inline-flex align-items-center justify-content-center mb-3"
                             style="width: 80px; height: 80px;">
                            <i class="bi bi-person-fill text-secondary" style="font-size: 2.5rem;"></i>
                        </div>
                        <h4 class="fw-bold mb-1">@Model.FullName</h4>
                        <p class="text-muted mb-0">@Model.Email</p>
                    </div>

                    <div class="bg-light rounded-3 p-3 mb-4">
                        <div class="row g-2">
                            <div class="col-6">
                                <small class="text-muted d-block">Phone Number</small>
                                <strong>@Model.PhoneNumber</strong>
                            </div>
                            <div class="col-6">
                                <small class="text-muted d-block">Address</small>
                                <strong>@Model.Address</strong>
                            </div>
                            <div class="col-6">
                                <small class="text-muted d-block">City</small>
                                <strong>@Model.City</strong>
                            </div>
                            <div class="col-6">
                                <small class="text-muted d-block">Postal Code</small>
                                <strong>@Model.PostalCode</strong>
                            </div>
                        </div>
                    </div>

                    <p class="text-center text-muted small mb-4">
                        Are you sure you want to permanently delete this customer profile?
                    </p>

                    <!-- Action buttons -->
                    <form asp-action="Delete" method="post" class="d-flex justify-content-center gap-3">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="partitionKey" value="@Model.PartitionKey" />
                        <input type="hidden" name="rowKey" value="@Model.RowKey" />

                        <a asp-action="Index" class="btn btn-outline-secondary px-4 py-2 rounded-pill">
                            Cancel
                        </a>

                        <button type="submit" class="btn btn-danger px-4 py-2 rounded-pill">
                            <i class="bi bi-trash3 me-1"></i> Yes, Delete
                        </button>
                    </form>
                </div>
            </div>

        </div>
    </div>
</div>