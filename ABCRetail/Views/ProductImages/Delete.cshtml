@model ABCRetail.Models.ProductImage

@{
    ViewData["Title"] = "Delete Image";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">

            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <!-- Header -->
                <div class="bg-danger bg-gradient text-white p-4 text-center">
                    <h3 class="mb-1 fw-bold">
                        <i class="bi bi-trash3-fill me-2"></i>Delete Image
                    </h3>
                    <p class="mb-0 opacity-75">This action cannot be undone</p>
                </div>

                <!-- Body -->
                <div class="card-body p-4 text-center">
                    <div class="mb-4">
                        <img src="@Model.Url"
                             alt="@Model.FileName"
                             class="img-fluid rounded-3 shadow-sm"
                             style="max-height: 280px; object-fit: contain;" />
                    </div>

                    <h5 class="fw-semibold mb-1">@Model.FileName</h5>
                    <p class="text-muted small mb-4">
                        Are you sure you want to permanently delete this image from Azure Blob Storage?
                    </p>

                    <!-- Action buttons -->
                    <form asp-action="Delete" method="post" class="d-flex justify-content-center gap-3">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="fileName" value="@Model.FileName" />

                        <a asp-action="Index" class="btn btn-outline-secondary px-4 py-2 rounded-pill">
                            Cancel
                        </a>

                        <button type="submit" class="btn btn-danger px-4 py-2 rounded-pill">
                            <i class="bi bi-trash3 me-1"></i> Yes, Delete
                        </button>
                    </form>
                </div>
            </div>

        </div>
    </div>
</div>